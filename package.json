{
  "name": "rentmate-peer-to-peer-rental-platform",
  "version": "1.0.0",
  "private": true,
  "description": "RentMate – Peer-to-Peer Rental Platform",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "seed": "npm run seed -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
